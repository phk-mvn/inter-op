{
  "name": "inter-op",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build:native": "pnpm --filter light-node-bridge run build",
    "build:ts": "pnpm -r --filter \"./packages/*\" run build",
    "build": "pnpm run build:native && pnpm run build:ts",
    "clean": "pnpm -r run clean && cargo clean"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}