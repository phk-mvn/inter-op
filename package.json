{
  "name": "inter-op",
  "version": "0.3.0",
  "packageManager": "pnpm@9.0.0",
  "author": "Danila Dukin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phk-mvn/inter-op.git"
  },
  "bugs": {
    "url": "https://github.com/phk-mvn/inter-op/issues"
  },
  "homepage": "https://github.com/phk-mvn/inter-op#readme",
  "keywords": [
    "electron",
    "electron-builder",
    "vite-electron",
    "electron-vite",
    "light-electron",
    "tauri",
    "neutralino",
    "neutralinoJS",
    "neutralinoTS",
    "NW.js",
    "NW",
    "wails",
    "serialport",
    "com",
    "port",
    "client",
    "server",
    "automation",
    "stream",
    "typescript"
  ],
  "scripts": {
    "build:native": "pnpm --filter light-node-bridge run build",
    "build:ts": "pnpm -r --filter \"./packages/*\" run build",
    "build": "pnpm run build:native && pnpm run build:ts",
    "sign": "powershell -ExecutionPolicy Bypass -File scripts/sign.ps1",
    "clean": "pnpm -r run clean && cargo clean"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}